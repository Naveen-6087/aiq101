# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Gemini API key (required) - get from https://aistudio.google.com
# Only the model construction in agent.py depends on this. Swap
# ChatGoogleGenerativeAI for ChatOpenAI, ChatAnthropic, or any other LangChain
# chat model and everything else (tools, ArmorIQLangChain, the agent) is unchanged.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# User email for ArmorIQ session scoping
USER_EMAIL=developer@armoriq.ai

# Name the sql-warehouse MCP server is registered under in the ArmorIQ
# dashboard (Platform > MCP Servers) - see README.md
SQL_MCP_NAME=sql-warehouse

# Optional: where the SQLite file lives (created from db/seed.sql if missing)
# ANALYTICS_DB=./analytics.db
