# ArmorIQ API Key (required) - get from https://platform.armoriq.ai, or run
# `armoriq login` via the SDK's bundled CLI
ARMORIQ_API_KEY=ak_live_your_api_key_here

# Gemini API key (required) - get from https://aistudio.google.com
# Only planner.py uses it. Swap planner.py for any model client that returns
# the same list of {"action", "params"} steps and nothing else changes.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# The end user the agent acts for. Tokens, audit rows, and approvals are tagged with it.
USER_EMAIL=developer@armoriq.ai

# Name the release-desk MCP server is registered under in the ArmorIQ
# dashboard (Platform > MCP Servers) - see README.md
RELEASE_DESK_MCP_NAME=release-desk

# Intent token lifetime in seconds (the SDK's own default is 60)
TOKEN_VALIDITY_SECONDS=300

# How long a held call waits for a human approver before giving up (ms)
APPROVAL_TIMEOUT_MS=300000
