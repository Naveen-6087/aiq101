# Intent Gateway key - Dashboard -> Gateway -> Create gateway key. The key is shown
# once, inside the base URL https://gw.armoriq.ai/v1/t/<gateway-key>. Keep it secret.
ARMORIQ_GATEWAY_KEY=your_gateway_key_here

# Agent id - Dashboard -> Gateway -> Agent policy. Leave empty to record traffic
# only (nothing checked, nothing blocked). Set it to check every tool call
# against that agent's active policy.
ARMORIQ_AGENT_ID=support-bot

# Gateway host. Only change it to point at the offline stand-in.
ARMORIQ_GATEWAY_HOST=https://gw.armoriq.ai

# Your Anthropic key, unchanged. The gateway forwards it to Anthropic and never stores it.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

# Sent as X-User-Email so the gateway attributes requests to the support agent
# using the bot, not the gateway key's owner. Not forwarded to Anthropic.
USER_EMAIL=dana@example.com
