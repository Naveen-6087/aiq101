{
  "profiles": {
    "armordev": {
      "rules": [
        {
          "id": "deny-secrets",
          "action": "deny",
          "tool": "*",
          "anyParam": {
            "$matches": "(?:^|[\\\\/\\s\"'=:])\\.env(?!\\.(?:example|sample|template)\\b)(?:\\.[\\w.-]+)?(?:$|[\\s\"'`;|&)<>])|(?:^|[\\\\/\\s\"'=:])\\.ssh(?:$|[\\\\/\\s\"'`;|&)<>])|(?:^|[\\\\/\\s\"'=:])\\.aws(?:$|[\\\\/\\s\"'`;|&)<>])|id_(?:rsa|dsa|ecdsa|ed25519)(?:$|[\\s\"'`;|&)<>])|\\.(?:pem|key|p12|pfx)(?:$|[\\s\"'`;|&)<>])|[\\\\/]credentials(?:\\.json)?(?:$|[\\s\"'`;|&)<>])|(?:^|[\\\\/\\s\"'=:])\\.(?:netrc|npmrc|pypirc|git-credentials)(?:$|[\\s\"'`;|&)<>])|\\.docker[\\\\/]config\\.json|\\.kube[\\\\/]config(?:$|[\\s\"'`;|&)<>])"
          }
        },
        {
          "id": "deny-destructive-shell",
          "action": "deny",
          "tool": "bash",
          "params": {
            "command": {
              "$matches": "\\brm\\s+(?:[^;&|\\n]*\\s)?(?:-[a-zA-Z]*[rR][a-zA-Z]*|--recursive)(?:\\s|$)|\\bgit\\s+reset\\s+(?:[^;&|\\n]*\\s)?--hard\\b|\\bgit\\s+clean\\s+(?:[^;&|\\n]*\\s)?-[a-zA-Z]*f|\\bdd\\s+[^;&|\\n]*\\bof=|\\bmkfs(?:\\.\\w+)?\\b|\\b(?:shred|wipefs)\\b|>\\s*/dev/(?:sd|nvme|disk)|\\bRemove-Item\\b[^;|\\n]*-Recurse"
            }
          }
        },
        {
          "id": "deny-force-push",
          "action": "deny",
          "tool": "bash",
          "params": {
            "command": {
              "$matches": "\\bgit\\s+push\\b[^;&|\\n]*(?:\\s--force(?:-with-lease)?\\b|\\s-[a-zA-Z]*f\\b|\\s\\+[\\w./-]+)"
            }
          }
        },
        {
          "id": "deny-push-protected-branch",
          "action": "deny",
          "tool": "bash",
          "params": {
            "command": {
              "$matches": "\\bgit\\s+push\\b[^;&|\\n]*[\\s:](?:main|master)(?:$|[\\s;&|])"
            }
          }
        },
        {
          "id": "deny-pipe-to-shell",
          "action": "deny",
          "tool": "bash",
          "params": {
            "command": {
              "$matches": "\\b(?:curl|wget)\\b[^;&\\n]*\\|\\s*(?:sudo\\s+)?(?:env\\s+)?(?:ba|z|da|k|fi)?sh\\b|\\b(?:curl|wget)\\b[^;&\\n]*\\|\\s*(?:sudo\\s+)?(?:python3?|node|perl|ruby)\\b|\\b(?:ba|z)?sh\\s+(?:-c\\s+)?[\"']?\\$\\(\\s*(?:curl|wget)\\b|\\b(?:ba|z)?sh\\s+<\\(\\s*(?:curl|wget)\\b|\\b(?:iwr|irm|Invoke-WebRequest|Invoke-RestMethod)\\b[^;\\n]*\\|\\s*(?:iex|Invoke-Expression)\\b"
            }
          }
        },
        {
          "id": "approve-package-publish",
          "action": "require_approval",
          "tool": "bash",
          "params": {
            "command": {
              "$matches": "\\b(?:npm|pnpm|yarn|bun)\\s+(?:[^;&|\\n]*\\s)?publish\\b|\\bcargo\\s+publish\\b|\\btwine\\s+upload\\b|\\b(?:poetry|flit|hatch|uv)\\s+publish\\b|\\bgem\\s+push\\b|\\bgh\\s+release\\s+create\\b|\\bdocker\\s+push\\b|\\bdotnet\\s+nuget\\s+push\\b"
            }
          }
        },
        {
          "id": "approve-network-shell",
          "action": "require_approval",
          "tool": "bash",
          "params": {
            "command": {
              "$matches": "\\b(?:curl|wget|nc|ncat|netcat|socat|scp|sftp|rsync|ssh|ftp|telnet|iwr|Invoke-WebRequest|Invoke-RestMethod)\\b"
            }
          }
        },
        {
          "id": "allow-test-build",
          "action": "allow",
          "tool": "bash",
          "params": {
            "command": {
              "$matches": "^(?:(?:npm|pnpm|yarn|bun)\\s+(?:run\\s+)?(?:test|build|lint|typecheck|check|format)\\b|npm\\s+ci\\b|npx\\s+(?:tsc|jest|vitest|eslint|prettier|playwright\\s+test)\\b|(?:pytest|tsc|jest|vitest|eslint|prettier|ruff|mypy|black|flake8|make)\\b|python3?\\s+-m\\s+(?:pytest|unittest|mypy|ruff|build)\\b|go\\s+(?:test|build|vet)\\b|cargo\\s+(?:test|build|check|clippy|fmt)\\b|(?:mvn|gradle|\\./gradlew)\\s+(?:test|build|verify|package|check)\\b|dotnet\\s+(?:test|build)\\b|node\\s+--test\\b|git\\s+(?:status|diff|log|show|branch|add|commit|fetch)\\b|(?:ls|pwd|cat|head|tail|wc|grep|rg|tree|which|echo)\\b)[^;&|`$()<>\\n\\r]*(?:\\|\\s*(?:grep|head|tail|wc|sort|uniq|jq|less|cat)\\b[^;&|`$()<>\\n\\r]*)*$"
            }
          }
        }
      ]
    }
  }
}
